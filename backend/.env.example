# ─── Server ─────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ─── MongoDB ─────────────────────────────────────────────────────────────────
# Local: mongodb://localhost:27017/multistore
# Atlas: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/multistore?retryWrites=true&w=majority
MONGO_URI=mongodb://localhost:27017/multistore

# ─── JWT ─────────────────────────────────────────────────────────────────────
JWT_SECRET=replace_with_a_long_random_string_min_32_chars
JWT_EXPIRES_IN=7d

# ─── CORS ────────────────────────────────────────────────────────────────────
CLIENT_URL=http://localhost:5173

# ─── AI Assistant (optional) ─────────────────────────────────────────────────
ANTHROPIC_API_KEY=

# ─── SuperAdmin Seed ─────────────────────────────────────────────────────────
SUPERADMIN_EMAIL=admin@multistore.com
SUPERADMIN_PASSWORD=change_this_password

# ─── Cloudinary (image uploads) ──────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ─── Encryption (for per-store payment gateway secrets) ─────────────────────
# Each store owner connects THEIR OWN Razorpay/Stripe/PayPal account in their
# dashboard (Settings → Payments) — this platform never touches their money.
# Their secret keys are encrypted with this before being stored in MongoDB.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Must be exactly 64 hex characters (32 bytes). Losing/rotating this key means
# every store owner has to re-enter their gateway secret keys.
ENCRYPTION_KEY=

# ─── SECURITY NOTE ───────────────────────────────────────────────────────────
# Never commit your real .env file. This .env.example is the only env file
# that should ever go into git — copy it to .env and fill in real values,
# and .gitignore already excludes .env from being tracked.
