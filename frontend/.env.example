# Base URL of your backend API — REQUIRED for any real deployment.
#
# This was the exact cause of "login doesn't work" on the live site: if this
# is left unset in a production build (e.g. on Vercel), the frontend silently
# calls its own domain instead of the backend, and every API request 404s.
#
# Local dev: leave this blank — vite.config.js already proxies /api to
# http://localhost:5000 for you.
#
# Production (Vercel/Netlify/etc): set this to your deployed backend URL,
# e.g. https://your-backend.onrender.com
VITE_API_URL=
